{
  "rules": {
    ".read": false,
    ".write": false,
    "cognilab": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "presence": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "$connection": { ".validate": "newData.val() === true" }
        }
      },
      "activity": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "$result": { ".validate": "newData.isBoolean()" }
        }
      },
      "feedback": {
        ".read": "auth != null",
        "$uid": {
          "$session": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['q1', 'q2', 'q3', 'submittedAt'])",
            "q1": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0" },
            "q2": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0" },
            "q3": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0" },
            "submittedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
