const EXERCISE_TITLES={"il-pianoforte":"Il pianoforte","lista-della-spesa":"Lista della spesa","attenzione-alternata":"Attenzione Alternata","cancellazione-h":"Cancellazione di H","cerchi-rossi":"Conta i cerchi","conta-numeri-lettere":"Conta i numeri e le lettere","doppio-compito":"Doppio compito e velocità","semaforo-parole":"Il semaforo delle parole","stroop-original":"Stroop","calcolo-memoria":"Calcolo e memoria","inibizione-memoria":"Inibizione e memoria di lavoro","memoria-lavoro-avanzato":"Memoria di lavoro avanzato","memoria-prosa":"Memoria di prosa con distrattori","memoria-visuospaziale-domande":"Memoria visuospaziale con domande","memoria-visuospaziale-numeri":"Memoria visuospaziale con numeri","memoria-giardino":"Memoria visuospaziale il Giardino","contrario-ricorda":"Rispondi al contrario e ricorda la parola","cifrario":"Il cifrario","n-back":"N back","n-back-semantico":"N back semantico","relazioni-logiche":"Relazioni logiche","rispondi-contrario":"Rispondi il contrario","set-shifting":"Set shifting","intruso-visivo":"Trova l'intruso","catena-parole":"Catena di parole","intruso-semantico":"Intruso semantico","torre-lettere":"La torre delle lettere","riordina-frase":"Riordina la frase","riordina-lettere":"Riordina le lettere","ordine-alfabetico":"Riordina le parole in ordine alfabetico","esplorazione-visuospaziale":"Esplorazione visuospaziale","memoria-rotante":"Memoria visuospaziale rotante","riconoscimento-base":"Riconoscimento visivo base","riconoscimento-visivo":"Riconoscimento visivo avanzato","silhouette":"Silhouette","immagine-corrispondente":"Trova l'immagine corrispondente","orologio-invisibile":"L'orologio invisibile","orientamento":"Orientamento temporale-spaziale"};
function assignmentEmail(program,titles={}){
 const lines=['Ciao,','', 'Il tuo professionista ti ha assegnato un nuovo programma su CogniLab.','', 'PROGRAMMA: '+program.name,'Professionista: '+program.professionalName,'Sessioni previste: '+program.totalSessions,''];
 if(program.schedule?.length)lines.push('CALENDARIO',...program.schedule.map((date,i)=>'Sessione '+(i+1)+': '+date.split('-').reverse().join('/')),'');
 lines.push('PROVE DA SVOLGERE IN OGNI SESSIONE');
 let previous=null;
 for(let i=0;i<program.exercises.length;i++){
  const id=program.exercises[i];let configuration={};try{configuration=JSON.parse(program.configurations?.[i]||'{}');}catch{}
  const options=[...(configuration.controls||[]).filter(c=>c.type!=='radio'||c.checked).filter(c=>c.value!==undefined).map(c=>(c.key||'Opzione')+': '+(c.type==='checkbox'?(c.checked?'attivo':'disattivo'):c.value)),...(configuration.buttons||[]).map(b=>b.label).filter(Boolean)];
  lines.push((i+1)+'. '+(titles[id]||id)+(previous===id?' (ripetizione)':''));if(options.length)lines.push('   Impostazioni predisposte: '+options.join(' · '));previous=id;
 }
 if(program.instructions)lines.push('','INDICAZIONI DEL PROFESSIONISTA',program.instructions);
 lines.push('','COME INIZIARE, PASSAGGIO PER PASSAGGIO','1. Apri https://enrico93ao.github.io/CogniLab/accesso.html','2. Accedi con l’email e la password del tuo account personale.','3. Nella sezione “I programmi assegnati”, cerca “'+program.name+'”.','4. Premi “Inizia sessione” oppure “Riprendi la sessione”.','5. Troverai le impostazioni già predisposte: leggi le istruzioni e avvia l’esercizio.','6. Alla fine attendi la conferma del salvataggio e premi “Esercizio successivo”. Ripeti anche le prove previste più volte.','7. Completa tutte le prove per concludere la sessione. Se interrompi, potrai riprenderla dallo stesso punto.','8. Torna al programma nelle date indicate per svolgere le sessioni successive.','','Non rispondere con password o informazioni sanitarie. Per dubbi sul programma contatta il tuo professionista.');
 return {subject:'CogniLab: nuovo programma disponibile',body:lines.join('\n')};
}

// Deploy as a web app, execute as the owner. No administrator Firebase credential.
const FIREBASE_API_KEY='AIzaSyBBChH3sFfhwE4waQTzERtKGytJrucYEFM';
const DATABASE_URL='https://hub-di-stimolazione-cognitiva-default-rtdb.firebaseio.com';
function jsonResponse(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return jsonResponse({ok:true,service:'CogniLab assignment notifications'});}
function firebaseRead(path,idToken){
 const response=UrlFetchApp.fetch(DATABASE_URL+'/'+path+'.json?auth='+encodeURIComponent(idToken),{muteHttpExceptions:true});
 if(response.getResponseCode()!==200)throw Error('permission-denied');return JSON.parse(response.getContentText());
}
function doPost(event){
 let lock;
 try{
  if(!event?.postData?.contents||event.postData.contents.length>12000)throw Error('invalid-request');
  const {idToken,patientUid,programId}=JSON.parse(event.postData.contents);
  if(typeof idToken!=='string'||!/^[A-Za-z0-9_-]{1,128}$/.test(patientUid||'')||!/^[A-Za-z0-9_-]{1,128}$/.test(programId||''))throw Error('invalid-request');
  const response=UrlFetchApp.fetch('https://identitytoolkit.googleapis.com/v1/accounts:lookup?key='+FIREBASE_API_KEY,{method:'post',contentType:'application/json',payload:JSON.stringify({idToken}),muteHttpExceptions:true});
  if(response.getResponseCode()!==200)throw Error('login-required');
  const user=JSON.parse(response.getContentText()).users?.[0];if(!user?.localId||user.disabled)throw Error('login-required');
  const uid=user.localId;if(firebaseRead('cognilab/professionals/'+uid,idToken)!==true)throw Error('professional-required');
  const program=firebaseRead('cognilab/carePrograms/'+patientUid+'/'+programId,idToken);
  if(!program||program.professionalId!==uid||program.status!=='active')throw Error('program-not-authorized');
  if(firebaseRead('cognilab/careLinks/'+patientUid+'/'+uid,idToken)!==true)throw Error('link-required');
  const record=firebaseRead('cognilab/users/'+uid+'/clinical/registeredPatients/'+patientUid,idToken);
  const recipient=record?.notificationEmail;
  if(typeof recipient!=='string'||recipient.length>254||!/^\S+@\S+\.\S+$/.test(recipient)||/[\r\n,;]/.test(recipient))throw Error('patient-email-missing');
  lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('busy-retry');
  const properties=PropertiesService.getScriptProperties(),key='assignment-'+patientUid+'-'+programId;
  const previous=properties.getProperty(key);if(previous==='sent')return jsonResponse({ok:true,state:'already-sent'});if(previous==='sending')throw Error('delivery-uncertain');
  if(MailApp.getRemainingDailyQuota()<1)throw Error('daily-quota');
  const email=assignmentEmail(program,EXERCISE_TITLES);
  properties.setProperty(key,'sending');
  // A pending marker is intentionally retained on an uncertain failure, avoiding automatic duplicates.
  MailApp.sendEmail({to:recipient,subject:email.subject,body:email.body,name:'CogniLab'});
  properties.setProperty(key,'sent');return jsonResponse({ok:true,state:'sent'});
 }catch(error){const allowed=['invalid-request','permission-denied','login-required','professional-required','program-not-authorized','link-required','patient-email-missing','busy-retry','delivery-uncertain','daily-quota'];return jsonResponse({ok:false,code:allowed.includes(error.message)?error.message:'send-failed'});}
 finally{if(lock&&lock.hasLock())lock.releaseLock();}
}
function authorizeMailer(){return MailApp.getRemainingDailyQuota();}
